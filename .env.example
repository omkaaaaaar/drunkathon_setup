# Start in mock mode while the team verifies InferexAI API details.
MOCK_MODE=true

INFEREX_API_KEY=
INFEREX_BASE_URL=https://api.inferexai.in/v1
INFEREX_CHAT_MODEL=
INFEREX_STT_MODEL=
INFEREX_TTS_MODEL=
INFEREX_TTS_VOICE=

# Confirm exact endpoints with the API tester/docs before using live mode.
INFEREX_STT_PATH=/audio/transcriptions
INFEREX_TTS_PATH=/audio/speech
REQUEST_TIMEOUT_SECONDS=45
DEFAULT_LANGUAGE=en
SCHEMES_FILE=data/schemes.json
